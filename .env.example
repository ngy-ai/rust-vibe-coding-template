# 复制为 .env 后生效（ngy-utils-tracing 通过 dotenvy 自动加载，且 .env 优先于进程环境变量）
# 变量名需带 NGY_ 前缀；RUST_LOG 是唯一不带前缀的例外。

# 开发时建议设为 development，否则默认 production 只写文件、控制台无输出
NGY_APP_MODE=development

# NGY_LOG_DIR=logs
# NGY_LOG_PREFIX=app.log
# NGY_LOG_MAX_FILES=7
# NGY_LOG_RETENTION_INTERVAL_SECONDS=3600
# NGY_LOG_TIME_OFFSET=+08:00
# RUST_LOG=info
